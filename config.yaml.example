server:
  host: "0.0.0.0" # 绑定监听 IP，0.0.0.0 表示允许内网与外网访问
  port: 8080
  api_keys:
    - "sk-opencode-secret-key-1"
    - "sk-opencode-secret-key-2"
  secret: "your-lan-proxy-secret-123456" # 局域网 Nginx 内部安全校验 Header (与 Nginx 中的 $http_x_proxy_secret 对应)
  max_body_mb: 100 # 入站请求体上限（MB），默认 100；需与节点 nginx 的 client_max_body_size 一致

default:
  cooldown_duration: "30m" # 默认冷却时长，不可换 IP 节点触发 429 后进入冷却

  # 明确的兜底模型配置：当客户端发来的模型名未在 model_mappings 匹配到时使用
  fallback_model: "deepseek-v4-flash-free"

  # 模型映射表 (支持多模型映射为 OpenCode 的目标模型)
  model_mappings:
    "gpt-4o": "deepseek-v4-flash-free"
    "gpt-3.5-turbo": "deepseek-v4-flash-free"
    "claude-3-5-sonnet": "deepseek-v4-flash-free"
    "deepseek-chat": "deepseek-v4-flash-free"

nodes:
  # 节点 1：支持更换临时公网 IP，配置调用多账号通用 Python 换 IP 脚本 (账号 1: DEFAULT)
  - name: "vps-node-phx-01"
    lan_url: "http://192.168.1.101:8080" # VPS 1 局域网 Nginx 入口
    supports_ip_change: true
    # ip_change_command: 主服务收到 429 时后台执行的 Shell 命令
    ip_change_command: "python3 /app/routeip/rotate_ip_multi.py --profile DEFAULT --instance-id ocid1.instance.oc1.phx.anyhqljtopuuszyczmgvid4xbt6kr5x57t7t3msvuyvxdyhsz3r3msrpee3a"
    cooldown_duration: "30m"

  # 节点 2：支持更换临时公网 IP，配置调用不同账号 Profile (账号 2: ACCOUNT_US_EAST)
  - name: "vps-node-iad-02"
    lan_url: "http://192.168.1.102:8080" # VPS 2 局域网 Nginx 入口
    supports_ip_change: true
    ip_change_command: "python3 /app/routeip/rotate_ip_multi.py --profile ACCOUNT_US_EAST --instance-id ocid1.instance.oc1.iad.abuwcljrq3xxxxxx"
    cooldown_duration: "30m"

  # 节点 3：固定 IP 节点 (不支持更换 IP，触发 429 后自动熔断冷却 30 分钟)
  - name: "vps-node-static-03"
    lan_url: "http://192.168.1.103:8080" # VPS 3 局域网 Nginx 入口
    supports_ip_change: false
    cooldown_duration: "30m"

# ===== Gemini 号池线路（Google AI Studio 独立线路，与上方 nodes 并行、互不影响） =====
# 未配置或 enabled: false 时不启用；此时所有请求恒走上方 OpenCode 节点线路（零行为变化）。
# 每个节点 = 一个 VPS（出口 IP）+ 一组 API key，在 nginx 上新增 /gemini/ location 转发到
# https://generativelanguage.googleapis.com/ （见 nginx/nginx.conf.template）。
# key 一律走 x-goog-api-key 请求头，不落 nginx access_log。
#
# 三种入站协议均支持命中 Gemini 线路：
#   OpenAI    POST /v1/chat/completions   （模型映射目标命中 models 列表即走本线路）
#   Anthropic POST /v1/messages           （同上）
#   原生      POST /v1beta/models/{model}:generateContent|:streamGenerateContent|:countTokens
#             GET  /v1beta/models[/{model}]
# 原生入口请求体原样透传（仅注入下述 force/safety 开关与 maxOutputTokens 兜底），
# 模型名支持 -search/-code/-real/-fake/-minimal/-low/-medium/-high 后缀（任意组合，自动剥离）。
# 认证兼容三种习惯：Authorization: Bearer <api_keys 之一> / x-goog-api-key 头 / ?key= query（校验后剥除）。
gemini:
  enabled: true
  # force: true                      # 调试用：所有请求强制走 Gemini（忽略模型映射）
  fallback_model: "gemini-2.5-flash" # 未命中映射时的兜底 Gemini 模型
  default_max_output_tokens: 8192    # 缺 max_tokens 时的兜底（Gemini 缺 maxOutputTokens 会 400）
  models:
    - "gemini-*"                     # 目标模型允许列表（支持前缀通配），命中即走 Gemini
  # client_models: ["my-gemini"]      # 可选：客户端模型名直接点名走 Gemini
  mount_path: "/gemini"              # 节点 nginx 挂载前缀（与 nginx location 对应）
  streaming_mode: "real"             # real|fake（可用 -real/-fake 模型后缀覆盖）
  force_thinking: false
  force_web_search: false
  force_code_execution: false
  force_url_context: false
  safety_settings_threshold: "OFF"
  # http_proxy: ""                   # 可选全局出站代理
  key_cooldown_duration: "60s"       # 单 key 429 冷却时长（带随机抖动去同步）
  ban_after_failures: 3              # 5xx/连接失败/403 连续失败阈值 → 禁用该 key
  max_rpm: 0                         # 0=不限制（可选每 key 每分钟上限）
  min_key_interval: "0s"             # 0=不限制（可选同 key 最小间隔）
  nodes:
    # 网关先换 key 再换节点：节点内 key 全部冷却后才切换到下一个节点
    - name: "gem-vps-sg-01"
      lan_url: "http://192.168.1.110:8080" # 与 OpenCode 同一 VPS nginx（需新增 /gemini/ location）
      api_keys:                              # 该节点绑定的一组 key（建议几十个）
        - "AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxx"
        - "AIzaSy-yyyyyyyyyyyyyyyyyyyyyyyyy"
      # key_cooldown_duration: "60s"   # 可选：节点级覆盖全局
      # max_rpm: 0
      # min_key_interval: "0s"
