# OpenCode 子节点 nginx 配置模板。两种部署形态：
#   1. 单 conf（默认示例形态）：listen 8080，本 server 自带 /gemini/ location，
#      主服务 gemini.lan_url 直接指向本端口，不配 upstream_host。
#   2. 双 conf（见 nginx/gemini.conf.template）：本文件 listen 行改为
#      listen 22578 default_server;
#      与 gemini server 块同端口、靠 server_name 区分路由（default_server 保证
#      Host 不匹配的流量永远落回本 server，与 conf 加载顺序无关），
#      主服务配 gemini.upstream_host 指向 gemini server 块的 server_name。
# 注意：/gemini/ location 与 nginx/gemini.conf.template 中的同款配置需保持一致
# （超时/头部），修改任一处时同步另一处。
server {
    # 绑定局域网/内网端口，只响应内网请求
    listen 8080;
    server_name _;

    # 入站请求体上限：与 Go 主服务 max_body_mb 对齐（nginx 默认仅 1MB，会话涨过 1MB 即被 413 拒绝）。
    # 注意：nginx 读不到主服务配置，调整主服务 max_body_mb 时此处需同步修改
    client_max_body_size 100m;

    location / {
        # 1. 验证来自 Go 主服务的 Secret 请求头
        if ($http_x_proxy_secret != "YOUR_CONFIGURED_SECRET") {
            return 403 "Forbidden";
        }

        # 2. 代理至 opencode.ai
        proxy_pass https://opencode.ai/;
        proxy_ssl_server_name on;
        proxy_ssl_name opencode.ai;

        # 3. 禁用缓冲区以支持 SSE 流式推流
        proxy_buffering off;
        proxy_cache off;

        # 4. 仅保留目标 Host，严禁添加 X-Forwarded-For / X-Real-IP / Via 等泄露主服务 IP 的标头
        proxy_set_header Host opencode.ai;
        proxy_set_header Connection '';
        proxy_http_version 1.1;
    }

    # Gemini 号池线路：/gemini/v1beta/... → https://generativelanguage.googleapis.com/v1beta/...
    # 前缀替换（/gemini/ 被 proxy_pass 的尾部 / 吃掉），query（如 ?alt=sse）自动透传
    location /gemini/ {
        if ($http_x_proxy_secret != "YOUR_CONFIGURED_SECRET") {
            return 403 "Forbidden";
        }

        proxy_pass https://generativelanguage.googleapis.com/;
        proxy_ssl_server_name on;
        proxy_ssl_name generativelanguage.googleapis.com;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;

        # Gemini 官方支持 x-goog-api-key 请求头（等价于 ?key=，避免 key 落入 access_log）
        proxy_set_header x-goog-api-key $http_x_goog_api_key;
        proxy_set_header Host generativelanguage.googleapis.com;
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header Connection '';
        proxy_http_version 1.1;

        # 同 /：不附加 X-Forwarded-For / X-Real-IP，避免泄露主服务 IP
    }
}
